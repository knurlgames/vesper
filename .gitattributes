* text=auto eol=lf
*.png binary
*.xcf binary
*.wav binary
*.ogg binary
*.ttf binary

# Models and textures are big and get re-exported often: keep them in Git LFS, not in history.
assets/**/*.glb filter=lfs diff=lfs merge=lfs -text
assets/**/*.png filter=lfs diff=lfs merge=lfs -text
# The store and Deck art (tools/store_art.gd): big PNGs too.
marketing/**/*.png filter=lfs diff=lfs merge=lfs -text
# The .import sidecars next to them are small text; keep them normal.
*.import -filter -diff -merge text
