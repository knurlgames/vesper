; Vesper's Kinky Kapers (working title). Open this folder in Godot 4.7.1, or run: godot --path .
; Controls are bound in code (core/controls.gd), not here.

config_version=5

[application]

config/name="Vesper's Kinky Kapers"
run/main_scene="res://levels/title/title.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Controls="*res://core/controls.gd"
Game="*res://core/game.gd"
Audio="*res://core/audio.gd"
Dialogue="*res://core/dialogue.gd"
Hud="*res://core/hud.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

[physics]

common/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_3d=2
